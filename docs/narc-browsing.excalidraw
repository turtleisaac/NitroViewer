    {
      "id": "narNoteB",
      "type": "text",
      "x": 822,
      "y": 1306,
      "width": 316,
      "height": 193,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 1963298994,
      "version": 1,
      "versionNonce": 1239691238,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Current: at 720 px the tree is a drawer.\nselect() already sets navOpen to false.\n\nProposed: keep that. The inspector\ndrawer becomes a near-full-height\nbottom sheet, with a peek of the grid\nabove the handle. Cycle, star, and Esc\nwork the same. Pulling the handle down\nor Close returns to the grid.\n\nBookmarks still live in the tree drawer.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Current: at 720 px the tree is a drawer.\nselect() already sets navOpen to false.\n\nProposed: keep that. The inspector\ndrawer becomes a near-full-height\nbottom sheet, with a peek of the grid\nabove the handle. Cycle, star, and Esc\nwork the same. Pulling the handle down\nor Close returns to the grid.\n\nBookmarks still live in the tree drawer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
