<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nitroviewer</groupId>
    <artifactId>nitroviewer-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>nitroviewer-core</name>
    <description>
        Transport-agnostic facade over Nds4j for NitroViewer. Exposes ROM browsing and 2D graphics
        decoding through methods that only take/return JSON, byte[] and base64 strings, so the same
        contract can run in-browser via CheerpJ or behind an HTTP backend.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- release 8 (not just source/target) so the facade compiles against the Java 8 API surface:
             CheerpJ's JRE is Java 8, and a Java 9+ API CALL (e.g. List.of, Optional.isEmpty) compiles
             fine under source/target 8 but throws NoSuchMethodError in the browser. This guard turns that
             into a build error HERE. Scoped to NitroViewer only — Nds4j keeps its own build config. -->
        <maven.compiler.release>8</maven.compiler.release>
        <!-- scripts/build-jars.sh installs the local Nds4j checkout via `mvn install` (under whatever
             version Nds4j's own pom.xml currently declares) and passes -Dnds4j.version to override this
             default. A hardcoded version here would silently drift from Nds4j's actual pom version
             (it has before — 1.0.0 vs 1.1.0-SNAPSHOT — and pulled the old Maven Central release instead
             of the fresh local build, breaking CI compilation without any local repro). -->
        <nds4j.version>1.0.0</nds4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.turtleisaac</groupId>
            <artifactId>Nds4j</artifactId>
            <version>${nds4j.version}</version>
        </dependency>
        <!-- Same Jackson line as PokEditor-Core. Shaded into this jar so CheerpJ does not need a third classpath entry. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The web app imports this same file. Java reads it for cipher direction. -->
            <resource>
                <directory>../web/src/gamedb</directory>
                <includes>
                    <include>gamedb.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 3.11 honors maven.compiler.release. The 3.1 default does not. -->
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <!-- JaCoCo instruction coverage. crapper reads target/site/jacoco/jacoco.xml. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- PIT stays off the default build. CI runs pitest:mutationCoverage. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.2</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.nitroviewer.core.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.nitroviewer.core.*</param>
                    </targetTests>
                    <outputFormats>
                        <outputFormat>XML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <failWhenNoMutations>false</failWhenNoMutations>
                </configuration>
            </plugin>
            <!-- Fold Jackson into this jar. Nds4j stays a separate CheerpJ classpath entry. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>com.fasterxml.jackson.core:jackson-databind</include>
                                    <include>com.fasterxml.jackson.core:jackson-core</include>
                                    <include>com.fasterxml.jackson.core:jackson-annotations</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Eclipse profile in config/eclipse-formatter.xml.
              ratchetFrom checks only Java files that differ from origin/main,
              so existing sources are not rewritten. CI must fetch that ref
              (fetch-depth: 0). JFormDesigner files and generated ANTLR are
              excluded: they are generated, not the style.
              
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <ratchetFrom>origin/main</ratchetFrom>
                    <java>
                        <eclipse>
                            <version>4.41</version>
                            <file>${project.basedir}/config/eclipse-formatter.xml</file>
                        </eclipse>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>12.3.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
