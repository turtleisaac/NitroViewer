<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nitroviewer</groupId>
    <artifactId>nitroviewer-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>nitroviewer-core</name>
    <description>
        Transport-agnostic facade over Nds4j for NitroViewer. Exposes ROM browsing and 2D graphics
        decoding through methods that only take/return JSON, byte[] and base64 strings, so the same
        contract can run in-browser via CheerpJ or behind an HTTP backend.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- release 8 (not just source/target) so the facade compiles against the Java 8 API surface:
             CheerpJ's JRE is Java 8, and a Java 9+ API CALL (e.g. List.of, Optional.isEmpty) compiles
             fine under source/target 8 but throws NoSuchMethodError in the browser. This guard turns that
             into a build error HERE. Scoped to NitroViewer only — Nds4j keeps its own build config. -->
        <maven.compiler.release>8</maven.compiler.release>
        <!-- scripts/build-jars.sh installs the local Nds4j checkout via `mvn install` (under whatever
             version Nds4j's own pom.xml currently declares) and passes -Dnds4j.version to override this
             default. A hardcoded version here would silently drift from Nds4j's actual pom version
             (it has before — 1.0.0 vs 1.1.0-SNAPSHOT — and pulled the old Maven Central release instead
             of the fresh local build, breaking CI compilation without any local repro). -->
        <nds4j.version>1.0.0</nds4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.turtleisaac</groupId>
            <artifactId>Nds4j</artifactId>
            <version>${nds4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <!--
              Eclipse profile in config/eclipse-formatter.xml.
              ratchetFrom checks only Java files that differ from origin/main,
              so existing sources are not rewritten. CI must fetch that ref
              (fetch-depth: 0). JFormDesigner files and generated ANTLR are
              excluded: they are generated, not the style.
              
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <ratchetFrom>origin/main</ratchetFrom>
                    <java>
                        <eclipse>
                            <version>4.41</version>
                            <file>${project.basedir}/config/eclipse-formatter.xml</file>
                        </eclipse>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>12.3.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-verify</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
