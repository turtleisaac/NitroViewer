# Text files use LF on every checkout.
* text=auto eol=lf

# Raster images, icons, ROMs, jars, and fonts stay byte-for-byte.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.icns binary
*.nds binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
