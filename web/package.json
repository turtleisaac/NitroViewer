{
  "name": "nitroviewer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": "turtleisaac",
    "email": "turtleisaac1@gmail.com"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://nitroviewer.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/turtleisaac/NitroViewer.git"
  },
  "description": "NitroViewer v1 SPA — a modern in-browser DS ROM viewer powered by Nds4j via CheerpJ.",
  "scripts": {
    "build-worklet": "node scripts/build-worklet.mjs",
    "dev": "npm run build-worklet && vite",
    "build": "tsc --noEmit && npm run build-worklet && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "mutate": "stryker run",
    "lint": "eslint . --max-warnings 0",
    "electron": "electron .",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.turtleisaac.nitroviewer",
    "productName": "NitroViewer",
    "copyright": "Copyright © NitroViewer contributors",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "web"
      },
      {
        "from": "vendor/cheerpj",
        "to": "web/cheerpj"
      }
    ],
    "directories": {
      "output": "../release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "electron/icon.png",
    "mac": {
      "icon": "electron/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "../LICENSE"
    },
    "dmg": {
      "title": "NitroViewer"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^38.8.6",
    "electron-builder": "24.13.3",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.11",
    "zustand": "^4.5.5"
  }
}
