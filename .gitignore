# ROMs — never commit copyrighted game files
*.nds

# Java / Maven build output
target/

# Generated jar bundles (rebuild with scripts/build-jars.sh)
spike/jars/*.jar
web/public/jars/*.jar

# Pre-bundled AudioWorklet module (rebuild with `npm run build-worklet`, or automatically via
# `npm run dev`/`npm run build` — see web/scripts/build-worklet.mjs)
web/public/sseq-worklet.js

# Node / web
node_modules/
dist/
.vite/
*.log
*.tsbuildinfo

# Electron packager output (`make build` → release/)
release/

# Vendored CheerpJ runtime (downloaded by scripts/vendor-cheerpj.sh)
web/vendor/cheerpj/

# JS sound-engine correctness fixtures — decoded audio extracted from a retail ROM at test time
# (see CheerpjFacadeTest#dumpSoundEngineFixtures); never commit ROM-derived assets.
web/src/sound/engine/__fixtures__/

# OS / editor
.DS_Store
.idea/
.vscode/
*.iml
